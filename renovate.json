{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/testdata/**",
    "examples/**"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "description": "Update the Go toolchain and golangci-lint together; golangci-lint must be built with a Go version at least as new as the code it lints",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "go",
        "golangci-lint"
      ],
      "groupName": "Go toolchain"
    },
    {
      "description": "The go directive in go.mod/go.work is the minimum supported Go version for consumers; raise it deliberately, not on every toolchain release",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "enabled": false
    },
    {
      "description": "Workspace modules are versioned and released together by the release process",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/finos/morphir-go/**"
      ],
      "enabled": false
    },
    {
      "description": "Group JavaScript runtimes and package managers used by mise tasks and toolchain backend tests",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "bun",
        "deno",
        "node",
        "pnpm",
        "yarn"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "JavaScript tooling"
    },
    {
      "description": "Group GitHub Actions minor/patch updates",
      "matchManagers": [
        "github-actions",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "GitHub Actions"
    }
  ],
  "customManagers": [
    {
      "description": "mise version pinned in jdx/mise-action steps",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "uses: jdx/mise-action@\\S+\\s+with:\\s+version:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
